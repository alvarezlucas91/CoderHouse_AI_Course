# ============================================================
# GROQ
# ============================================================

# API Key de Groq.
# Obtener desde la consola de Groq.
GROQ_API_KEY=XXXXXXXXXXXXX

# Modelo utilizado por el agente.
GROQ_MODEL=llama-3.3-70b-versatile


# ============================================================
# LANGGRAPH
# ============================================================

# Máximo número de pasos permitidos durante una ejecución
# del grafo para evitar ciclos infinitos.
RECURSION_LIMIT=10
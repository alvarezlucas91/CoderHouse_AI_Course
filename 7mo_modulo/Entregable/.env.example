REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
JOB_TTL_SECONDS=604800

# Phoenix local. Para Phoenix Cloud, cambia endpoint y agrega PHOENIX_API_KEY.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=modulo-7-api-agente
PHOENIX_API_KEY=

# Opcional. Por defecto apunta al vectorstore del Módulo 3 en este repositorio.
CHROMA_PATH=
